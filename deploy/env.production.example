# /srv/ipsengpt/app/.env on the droplet. Read by Docker Compose and the app.
# Paths (DB, people, web, persona) are fixed inside the image; see the Dockerfile.

# Image tag to run; deploy.sh sets this.
IPSENGPT_TAG=latest

# Primary: the PC's Ollama, reached through the reverse SSH tunnel.
OLLAMA_URL=http://127.0.0.1:11435
OLLAMA_MODEL=qwen3-vl:4b-instruct
# Fallback: the ollama container in this stack.
OLLAMA_FALLBACK_URL=http://127.0.0.1:11434
OLLAMA_FALLBACK_MODEL=llama3.2:1b
OLLAMA_PRIMARY_RETRY_MS=30000
# Dead PC (no answer to a health check) -> fallback after 3 s.
OLLAMA_CONNECT_TIMEOUT_MS=3000
# Busy PC (alive, queued) -> wait up to 15 s for the first token before falling back.
OLLAMA_FIRST_TOKEN_TIMEOUT_MS=15000
OLLAMA_NUM_CTX=4096

# Admin: use a long random password, e.g. `openssl rand -base64 18`.
ADMIN_PASSWORD=
ADMIN_COOKIE_SECURE=true

RATE_CHAT_SESSION=8/60
RATE_CHAT_IP=120/60
RATE_SESSION_CREATE_IP=30/600
RATE_ADMIN_LOGIN_IP=5/900
