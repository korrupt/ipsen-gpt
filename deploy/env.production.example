# /srv/ipsengpt/app/.env on the droplet. Read by Docker Compose and the app.
# Paths (DB, people, web, personas) are fixed inside the image; see the Dockerfile.

# Image tag to run; deploy.sh sets this.
IPSENGPT_TAG=latest

# The PC's Ollama, reached through the reverse SSH tunnel. There is no fallback:
# while the PC can't be reached, guests see that chat is closed.
OLLAMA_URL=http://127.0.0.1:11435
OLLAMA_MODEL=qwen3-vl:8b-instruct
# How often the app checks that the PC is there (guests see changes live).
OLLAMA_CHECK_INTERVAL_MS=5000
# Dead PC (no answer to a health check within 3 s) -> chat closes.
OLLAMA_CONNECT_TIMEOUT_MS=3000
# Busy PC (alive, queued) -> wait up to 45 s for the first token, then that reply fails.
OLLAMA_FIRST_TOKEN_TIMEOUT_MS=45000
OLLAMA_NUM_CTX=4096

# Gates are edited in admin and live in /srv/ipsengpt/gates (seeded from the image on first start).
# Text gates pass when the model is at least this sure the answer does what was asked.
TEXT_GATE_CONFIDENCE_MIN=0.7
PHOTO_CONFIDENCE_MIN=0.7
PHOTO_VERIFY_TIMEOUT_MS=45000

# Admin: use a long random password, e.g. `openssl rand -base64 18`.
ADMIN_PASSWORD=
ADMIN_COOKIE_SECURE=true

RATE_CHAT_SESSION=8/60
RATE_CHAT_IP=120/60
RATE_SESSION_CREATE_IP=30/600
RATE_ADMIN_LOGIN_IP=5/900
RATE_PHOTO_SESSION=1/15
RATE_PHOTO_IP=60/60
RATE_SECRET_SESSION=5/120
