# Copy to .env and adjust. Relative paths resolve against the directory of this file.

# --- Server ---
HOST=127.0.0.1
PORT=3000

# --- Ollama ---
# Primary LLM endpoint (in production: the SSH tunnel on 127.0.0.1:11435).
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-vl:8b
OLLAMA_NUM_CTX=4096
OLLAMA_TEMPERATURE=0.8
# Give up if Ollama hasn't started responding within this many ms.
OLLAMA_CONNECT_TIMEOUT_MS=3000
# Abort a reply that takes longer than this in total.
OLLAMA_REPLY_TIMEOUT_MS=60000
# Fallback when the primary fails before replying (empty = no fallback).
# Production: the ollama container on the droplet, http://127.0.0.1:11434
OLLAMA_FALLBACK_URL=
OLLAMA_FALLBACK_MODEL=llama3.2:1b
# After the primary fails, use the fallback for this long before trying the primary again.
OLLAMA_PRIMARY_RETRY_MS=30000

# --- Chat ---
PERSONA_PATH=content/persona.md
CHAT_MAX_INPUT_CHARS=500
# Number of previous user+assistant turns included in the prompt.
CHAT_HISTORY_TURNS=8
SSE_HEARTBEAT_MS=20000

# --- Frontend ---
# Built frontend served by the server in production.
WEB_DIST=apps/web/dist

# --- Storage (mount these as volumes in production) ---
DB_PATH=data/ipsengpt.sqlite
PEOPLE_DIR=data/people

# --- Admin (/admin) ---
# Admin is disabled until this is set (min 8 characters).
ADMIN_PASSWORD=
# Secure cookies need HTTPS. localhost counts as secure in Chrome/Firefox;
# set to false only to test admin over plain http on your LAN.
ADMIN_COOKIE_SECURE=true
ADMIN_SESSION_HOURS=24

# --- Rate limits: "count/seconds" ---
# Guests on the party Wi-Fi share one public IP, so per-IP limits are generous.
RATE_CHAT_SESSION=8/60
RATE_CHAT_IP=120/60
RATE_SESSION_CREATE_IP=30/600
RATE_ADMIN_LOGIN_IP=5/900
